dump.rdb
*.aof

# ---------------------------------------------
# Zero-knowledge artifacts (circom / snarkjs)
# ---------------------------------------------
# Powers of Tau ceremony files (large, generated)
ptau/
*.ptau
# Compiled circuit outputs
*.r1cs
*.sym
*.wasm
*.zkey
*.vkey
*.wtns
# snarkjs witness-generator folder (e.g. fundproof_js/)
*_js/
# Generated keys, proofs and public signals
verification_key.json
proof.json
public.json
build/circuits/input.json
# Downloaded prover/verifier tooling (e.g. circom binary)
/tools/
circom
circom.exe

# ---------------------------------------------
# Rust / Cargo (on-chain verifier contract)
# ---------------------------------------------
**/target/
**/*.rs.bk
# Windows rustup installer binary (~12 MB, should not be committed)
rustup-init.exe

